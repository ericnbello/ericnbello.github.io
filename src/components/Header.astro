---
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];
---
<header class="site-header">
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Eric Bello home">
      <span class="brand-mark" aria-hidden="true">EB</span>
      <span class="brand-name">Eric Bello</span>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} class:list={[isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="nav-linkedin" href="https://linkedin.com/in/ericnbello" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
  </div>
</header>
