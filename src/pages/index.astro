---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="hero-availability"><span aria-hidden="true"></span> Miami, Florida · Open to technical opportunities</p>
      <h1>Eric Bello</h1>
      <p class="hero-role">IT infrastructure · cloud · security</p>
      <p class="hero-lead">Computer Engineering graduate with hands on experience building and supporting Windows infrastructure, AWS environments, identity systems, and technical applications.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">View technical work <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/about/">Background and credentials</a>
      </div>
      <div class="hero-links" aria-label="Professional profiles">
        <a href="https://linkedin.com/in/ericnbello" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/ericnbello" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="mailto:ericnbello@gmail.com">Email <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <aside class="hero-profile" aria-label="Eric Bello profile">
      <div class="portrait-frame">
        <img class="hero-profile__image" src="https://avatars.githubusercontent.com/u/42421358?s=520&v=4" alt="Eric Bello" width="360" height="360" loading="eager" />
        <span class="portrait-rule" aria-hidden="true"></span>
      </div>
      <div class="profile-note">
        <span>Technical direction</span>
        <strong>Infrastructure foundation with a growing security operations focus.</strong>
      </div>
    </aside>

    <div class="credential-band" aria-label="Education and certifications">
      <div><span>Education</span><strong>B.S. Computer Engineering</strong><small>Florida International University</small></div>
      <div><span>Certification</span><strong>CompTIA Security+</strong><small>Security fundamentals</small></div>
      <div><span>Certification</span><strong>CompTIA Network+</strong><small>Networking fundamentals</small></div>
      <div><span>Certification</span><strong>AWS Cloud Practitioner</strong><small>Cloud fundamentals</small></div>
    </div>
  </section>

  <section class="scan-section shell" aria-labelledby="technical-focus">
    <div class="section-heading compact-heading">
      <h2 id="technical-focus">Technical focus</h2>
      <p>Systems, platforms, and disciplines I have worked with directly through labs, projects, and independent technical work.</p>
    </div>
    <div class="focus-grid">
      <div class="focus-item">
        <h3>Infrastructure & identity</h3>
        <p>Windows Server, Active Directory, Entra ID, Group Policy, DNS, DHCP, access administration, and virtualization.</p>
      </div>
      <div class="focus-item">
        <h3>Cloud & automation</h3>
        <p>AWS, Lambda, S3, CloudFront, API Gateway, DynamoDB, CloudFormation, SAM, and GitHub Actions.</p>
      </div>
      <div class="focus-item">
        <h3>Security foundations</h3>
        <p>Access control, MFA, system hardening concepts, patch management, network security fundamentals, and security focused lab work.</p>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <h2>Selected technical work</h2>
      <p>Three projects that show how I approach cloud infrastructure, identity systems, application development, and technical problem solving.</p>
    </div>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="proof-section shell">
    <div class="proof-copy">
      <p class="section-label">Technical toolkit</p>
      <h2>Built around systems, not buzzwords.</h2>
      <p>My background combines a Computer Engineering education with practical work across Windows infrastructure, AWS, application development, and security fundamentals.</p>
      <a class="text-link" href="/about/">Explore my background <span aria-hidden="true">→</span></a>
    </div>
    <div class="proof-list">
      <div><strong>Systems</strong><span>Windows Server, Active Directory, DNS, DHCP, virtualization</span></div>
      <div><strong>Cloud</strong><span>AWS architecture, serverless services, infrastructure as code, CI/CD</span></div>
      <div><strong>Development</strong><span>Python, JavaScript, TypeScript, Django, REST APIs</span></div>
      <div><strong>Security</strong><span>Security+, access control, MFA, hardening concepts, security operations direction</span></div>
    </div>
  </section>

  <section class="closing">
    <div class="shell closing-inner">
      <div class="closing-copy">
        <p class="section-label section-label-light">Next step</p>
        <h2>Looking for a technical professional who can learn systems quickly and work through problems methodically?</h2>
        <p>I’m interested in roles across IT support, infrastructure, cloud, and security where I can contribute now and continue deepening my systems experience.</p>
      </div>
      <div class="closing-actions">
        <a class="button button-inverse" href="/contact/">Contact me <span aria-hidden="true">→</span></a>
        <a class="closing-link" href="https://linkedin.com/in/ericnbello" target="_blank" rel="noopener noreferrer">View LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
